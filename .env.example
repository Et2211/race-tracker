# Copy to .env.local and fill in. Never commit real values.
# Every variable here is read on the server only. None use the NEXT_PUBLIC_ prefix,
# so none are bundled into browser code.

# --- OpenF1 -------------------------------------------------------------------
# Historical data (2023 onwards) needs no credentials. Leave these empty unless
# you have the paid (sponsor) tier, which is needed only for live mode (M7).
# The server exchanges them for a 1-hour bearer token at https://api.openf1.org/token
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Base URL, overridable for tests or a local proxy.
OPENF1_API_BASE=https://api.openf1.org/v1

# --- Data mode ----------------------------------------------------------------
# "openf1"  : fetch from OpenF1 (cached)
# "fixtures": use recorded fixtures only, with no network access (tests, offline dev)
F1_DATA_MODE=openf1

# --- Storage ------------------------------------------------------------------
# Sessions are stored as gzipped JSON. With a Vercel Blob store connected to the project,
# BLOB_READ_WRITE_TOKEN is set automatically and Blob is used; otherwise STORE_DIR on disk.
# BLOB_READ_WRITE_TOKEN=
# STORE_DIR=.cache/store
# New downloads are refused above this many MB (Vercel Blob on Hobby includes 1 GB).
# STORE_CAP_MB=900
