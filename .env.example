# Copy to .env.local and fill in. Never commit real values.
# Every variable here is read on the server only. None use the NEXT_PUBLIC_ prefix,
# so none are bundled into browser code.

# --- OpenF1 -------------------------------------------------------------------
# Historical data (2023 onwards) needs no credentials. Leave these empty unless
# you have the paid (sponsor) tier, which is needed only for live mode (M7).
# The server exchanges them for a 1-hour bearer token at https://api.openf1.org/token
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Base URL, overridable for tests or a local proxy.
OPENF1_API_BASE=https://api.openf1.org/v1

# --- Data mode ----------------------------------------------------------------
# "openf1"  : fetch from OpenF1 (cached)
# "fixtures": use recorded fixtures only, with no network access (tests, offline dev)
F1_DATA_MODE=openf1

# --- Storage ------------------------------------------------------------------
# Downloaded sessions are kept as gzipped JSON. With these two set, they go to the Supabase
# project's private "sessions" bucket (schema: supabase/migrations); otherwise to STORE_DIR on disk.
# Use the project's secret key (sb_secret_...), from Project Settings > API Keys. Server only.
SUPABASE_URL=https://ehrzywzowkbpfhlcjtuy.supabase.co
SUPABASE_SECRET_KEY=
# STORE_DIR=.cache/store
# New downloads are refused above this many MB (Supabase's free plan includes 1 GB of storage).
# STORE_CAP_MB=900

# --- Scheduled downloads --------------------------------------------------------
# Shared secret for /api/cron/calendar and /api/cron/download, called by the Supabase jobs in
# supabase/cron.sql (same value stored in Supabase Vault). Without it those endpoints are closed.
# Generate with: openssl rand -hex 32
CRON_SECRET=
