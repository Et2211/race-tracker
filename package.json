{
  "name": "race-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx scripts/backtest.mts",
    "ingest": "tsx scripts/ingest.mts",
    "test:e2e": "next build && playwright test",
    "store:upload": "tsx scripts/store-upload.mts",
    "backfill": "tsx --tsconfig scripts/tsconfig.json scripts/backfill.mts",
    "fake-openf1": "tsx --tsconfig scripts/tsconfig.json scripts/fake-openf1.mts",
    "live:check": "tsx --tsconfig scripts/tsconfig.json scripts/live-check.mts",
    "test:live": "tsx --tsconfig scripts/tsconfig.json scripts/test-live.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "mqtt": "^5.16.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": "26.x"
  }
}
